      "extendable": false,
      "applies_procedure": ["一审"],
      "basis": "民诉法 §128（收到起诉状副本之日起 15 日内提出答辩状）",
      "severity": "high"
    },
    {
      "id": "jurisdiction_objection",
      "name": "管辖权异议期",
      "trigger": "served",
      "kind": "statutory",
      "days": 15, "unit": "natural_days",
      "direction": "after", "count_from": "next_day", "roll": "forward",
      "service_modifiers": {
