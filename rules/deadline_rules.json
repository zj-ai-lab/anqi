      "trigger": "evidence_notice",
      "kind": "court_specified",
      "task_title": "录入举证期限届满日（举证通知载明）",
      "basis": "法院指定（民诉法 §68 及证据规定，普通程序不少于 15 日）",
      "severity": "high"
    },
    {
      "id": "fee_deadline_entry",
      "name": "预交诉讼费期限",
      "trigger": "fee_notice",
      "kind": "court_specified",
