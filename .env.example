# 案齐 env 样例。复制为 .env（已 gitignore），用 `npm run dev` 启动（Node 原生 --env-file，无新依赖）。

# 监听地址：默认 127.0.0.1。本机开发保持回环；Docker 镜像已显式设 HOST=0.0.0.0。
# 非回环监听必须同时配置完整登录凭据与 ANJIAN_INTERNAL_KEY，否则拒绝启动。
HOST=127.0.0.1
# PORT=3001

# 登录门：正常运行必须同时配置账号与版本化 scrypt hash，缺任一项都会拒绝启动。
ANJIAN_USER=
ANJIAN_PASS_HASH=
# 在仓库根安全生成 hash（明文不写文件、不作为命令行参数）：
#   read -s -p "Password: " P; printf '\n'
#   ANJIAN_PASSWORD="$P" node tools/hash-password.js
#   unset P
# 内存宽裕时可提高新 hash 的生成成本（16384–262144 之间的 2 的幂）：
# ANJIAN_SCRYPT_N=32768

# 仅供无真实数据的本机开发/自动化测试：必须精确为 1、非 production、且 HOST 是明确回环 IP。
# production 或非回环绑定使用它会直接拒绝启动；正常使用请删除，不要设为 0/false。
# NODE_ENV=development
# ANJIAN_UNSAFE_NO_AUTH=1

# 可信代理：默认 loopback,linklocal,uniquelocal。可收窄为 false/0、1–10 hop 或逗号分隔 CIDR。
# 不接受笼统的 true。无反向代理的本机开发可设 false。
# ANJIAN_TRUST_PROXY=loopback

# 受信任自动化专用内部接口 key（/internal/*）。无 key 时正常模式恒 503；公网反代还应硬 404。
# 非回环监听时此项必填，并应与密码、静态 token 分开生成。
ANJIAN_INTERNAL_KEY=

# CLI/agent 兼容 cookie token，可选；不能替代管理员登录凭据。
# ANJIAN_STATIC_TOKEN=
# 新记录默认审计 actor，未配置为 web；个人部署可设稳定代号。
# ANJIAN_DEFAULT_ACTOR=web

# 案件夹根 = 唯一文件真相源（DESIGN §8.5）。其下一级 = 案件根文件夹，文件夹名必须 == cases.name。
# 不配 → 文件模块整体 503（页面显示「文件根未配置或不可达」），其余功能不受影响。
ANJIAN_FILES_ROOT=
# Mac：填本机同步树的绝对路径。
# ANJIAN_FILES_ROOT=/absolute/path/to/case-files
# Docker：挂载案件夹后使用容器内路径。
# ANJIAN_FILES_ROOT=/app/files
# 本地联调沙盒（不得指向真实案件夹）：
# ANJIAN_FILES_ROOT=./data/files-dev

# 快录整理：DeepSeek 官方 API key。不配时隐藏「整理」按钮，手动快录不受影响。
# 只发送使用者明确输入的文字；启用前自行审查供应商的数据条款。
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 每日 digest Discord webhook（L0 提醒，固定代码直发，不经模型）。
# ANJIAN_DISCORD_WEBHOOK=
