{
  "name": "anjian",
  "version": "2.7.0-beta.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "seed": "node tools/seed-demo.js",
    "check": "npm run rebuild:node && bash tools/check.sh",
    "qa:finance": "bash tools/run-finance-ui-qa.sh",
    "rebuild:node": "npm rebuild better-sqlite3",
    "agent:update-runtime": "node tools/update-dsh-runtime.mjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "icon:build": "bash tools/build-icon.sh",
    "electron:dev": "npm run electron:rebuild && electron .",
    "dist": "npm run electron:rebuild && node build/ensure-cross-arch-optional-deps.mjs && electron-builder --mac"
  },
  "build": {
    "appId": "asia.fdonglawyer.anjian",
    "productName": "案齐",
    "artifactName": "anqi-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "server.js",
      "src/**",
      "!src/agent/runtime/**",
      "!src/agent/assets/**",
      "public/**",
      "rules/**",
      "tools/**",
      "electron/**",
      "LICENSE",
      "LICENSES/**",
      "ACKNOWLEDGEMENTS.md",
      "LEGAL-NOTICE.md",
      "package.json",
      "package-lock.json"
    ],
    "asar": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "src/agent",
        "to": "agent-runtime",
        "filter": [
          "runtime{,/**/*}",
          "assets{,/**/*}",
          "!assets/node_modules{,/**/*}"
        ]
      }
    ],
    "afterPack": "build/afterpack-agent-runtime-link.cjs",
    "afterSign": "build/adhoc-sign.cjs",
    "copyright": "Copyright © 2026 方律",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "ANQI ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "zj-ai-lab",
      "repo": "anqi"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "minimatch": "^10.2.6"
  },
  "allowScripts": {
    "electron@43.4.0": true,
    "better-sqlite3@13.0.3": true,
    "electron-winstaller": false
  }
}
